rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default Deny All
    match /{document=**} {
      allow read, write: if false;
    }

    // --- HARDENED PRIMITIVES & IDENTITY HELPERS ---
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(ownerId) {
      return isVerifiedUser() && request.auth.uid == ownerId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    // --- ENTITY SCHEMA VALIDATORS ---

    function isValidUserSchema(data) {
      return data.keys().hasAll(['id', 'displayName', 'email', 'avatar', 'createdAt', 'updatedAt'])
        && data.id is string 
        && data.id == request.auth.uid
        && data.displayName is string 
        && data.displayName.size() >= 1 
        && data.displayName.size() <= 100
        && data.email is string 
        && data.email == request.auth.token.email
        && data.email.size() <= 100
        && data.avatar is string 
        && data.avatar.size() <= 150
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidChatSchema(data) {
      return data.keys().hasAll(['id', 'ownerId', 'peerId', 'peerName', 'lastMessageText', 'updatedAt'])
        && data.id is string
        && isValidId(data.id)
        && data.ownerId is string
        && data.ownerId == request.auth.uid
        && data.peerId is string
        && isValidId(data.peerId)
        && data.peerName is string
        && data.peerName.size() <= 100
        && data.lastMessageText is string
        && data.lastMessageText.size() <= 1000
        && data.updatedAt is timestamp;
    }

    function isValidMessageSchema(data) {
      return data.keys().hasAll(['id', 'senderId', 'senderName', 'text', 'timestamp', 'status', 'channelType'])
        && data.id is string
        && isValidId(data.id)
        && data.senderId is string
        && isValidId(data.senderId)
        && data.senderName is string
        && data.senderName.size() <= 100
        && data.text is string
        && data.text.size() <= 5000
        && data.timestamp is int
        && data.status is string
        && data.status in ['sending', 'sent', 'delivered', 'read']
        && data.channelType is string
        && data.channelType in ['bluetooth', 'wifi-direct'];
    }

    function isValidFileSchema(data) {
      return data.keys().hasAll(['id', 'ownerId', 'fileName', 'fileSize', 'progress', 'speed', 'direction', 'peerId', 'peerName', 'status', 'timestamp'])
        && data.id is string
        && isValidId(data.id)
        && data.ownerId is string
        && data.ownerId == request.auth.uid
        && data.fileName is string
        && data.fileName.size() <= 255
        && data.fileSize is int
        && data.progress is int
        && data.progress >= 0
        && data.progress <= 100
        && data.speed is int
        && data.direction is string
        && data.direction in ['send', 'receive']
        && data.peerId is string
        && isValidId(data.peerId)
        && data.peerName is string
        && data.peerName.size() <= 100
        && data.status is string
        && data.status in ['pending', 'transferring', 'completed', 'failed']
        && data.timestamp is int;
    }

    // --- RULES SPECIFICATION BY COLLECTION ---

    // 1. User Profiles Collection
    match /users/{userId} {
      allow get: if isVerifiedUser() && request.auth.uid == userId;
      // Secure list query: ensure users can only list their own profile
      allow list: if isVerifiedUser() && userId == request.auth.uid;

      allow create: if isVerifiedUser() 
        && userId == request.auth.uid
        && isValidUserSchema(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser() 
        && userId == request.auth.uid
        && isValidUserSchema(incoming())
        && incoming().createdAt == resource.data.createdAt // Immutability of creation date
        && incoming().updatedAt == request.time;

      allow delete: if isVerifiedUser() && userId == request.auth.uid;
    }

    // 2. Chat Backup Collections
    match /chats/{chatId} {
      allow get: if isVerifiedUser() && resource.data.ownerId == request.auth.uid;
      // Secure list query: prevents scraping other users' chat threads
      allow list: if isVerifiedUser() && resource.data.ownerId == request.auth.uid;

      allow create: if isVerifiedUser() 
        && isValidId(chatId)
        && isValidChatSchema(incoming())
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(chatId)
        && resource.data.ownerId == request.auth.uid
        && isValidChatSchema(incoming())
        && incoming().ownerId == resource.data.ownerId // ownerId cannot be spoofed/altered
        && incoming().peerId == resource.data.peerId // peerId is immutable
        && incoming().updatedAt == request.time;

      allow delete: if isVerifiedUser() && resource.data.ownerId == request.auth.uid;

      // 3. Message Backups Sub-collection
      match /messages/{messageId} {
        allow get: if isVerifiedUser() && get(/databases/$(database)/documents/chats/$(chatId)).data.ownerId == request.auth.uid;
        // Secure list query
        allow list: if isVerifiedUser() && get(/databases/$(database)/documents/chats/$(chatId)).data.ownerId == request.auth.uid;

        allow create: if isVerifiedUser()
          && isValidId(chatId)
          && isValidId(messageId)
          && get(/databases/$(database)/documents/chats/$(chatId)).data.ownerId == request.auth.uid
          && isValidMessageSchema(incoming());

        // Messages are historically immutable. No client edits or deletions permitted.
        allow update, delete: if false;
      }
    }

    // 4. File Transfers Collection
    match /files/{fileId} {
      allow get: if isVerifiedUser() && resource.data.ownerId == request.auth.uid;
      // Secure list query
      allow list: if isVerifiedUser() && resource.data.ownerId == request.auth.uid;

      allow create: if isVerifiedUser()
        && isValidId(fileId)
        && isValidFileSchema(incoming());

      allow update: if isVerifiedUser()
        && isValidId(fileId)
        && resource.data.ownerId == request.auth.uid
        && isValidFileSchema(incoming())
        && incoming().ownerId == resource.data.ownerId
        && incoming().timestamp == resource.data.timestamp; // immutable timestamp

      allow delete: if isVerifiedUser() && resource.data.ownerId == request.auth.uid;
    }
  }
}
